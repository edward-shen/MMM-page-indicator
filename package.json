{
  "name": "mmm-page-indicator",
  "version": "0.3.8",
  "description": "A helper module for MagicMirror² to display what page you're on.",
  "main": "MMM-page-indicator.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edward-shen/MMM-page-indicator.git"
  },
  "keywords": [
    "Pages",
    "Slides"
  ],
  "author": "Edward Shen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/edward-shen/MMM-page-indicator/issues"
  },
  "homepage": "https://github.com/edward-shen/MMM-page-indicator#readme",
  "scripts": {
    "demo": "cd ../../ && MM_CONFIG_FILE=modules/MMM-page-indicator/demo.config.js node --run start:dev",
    "lint": "eslint && prettier . --check",
    "lint:fix": "eslint --fix && prettier . --write",
    "prepare": "simple-git-hooks || true",
    "release": "commit-and-tag-version --config ./changelog.config.mjs",
    "test": "node --run lint && node --run test:spelling && node --run test:unit",
    "test:spelling": "cspell .",
    "test:unit": "node --test tests/unit/**/*.test.js"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commit-and-tag-version": "^13.3.0",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "unrs-resolver@1.12.2": true
  }
}
